// ---------- Helper: Number to Words ----------
function numberToWords(num) {
  if (num === 0) return 'Zero';
  const a = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten',
    'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
  const b = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];
  const numStr = String(Math.round(num));
  const len = numStr.length;
  if (len <= 2) {
    if (num < 20) return a[num];
    return b[Math.floor(num / 10)] + (num % 10 ? ' ' + a[num % 10] : '');
  }
  if (len === 3) return a[Math.floor(num / 100)] + ' Hundred' + (num % 100 ? ' and ' + numberToWords(num % 100) : '');
  if (len === 4) return a[Math.floor(num / 1000)] + ' Thousand' + (num % 1000 ? ' ' + numberToWords(num % 1000) : '');
  if (len === 5) {
    const t = Math.floor(num / 1000);
    const r = num % 1000;
    return numberToWords(t) + ' Thousand' + (r ? ' ' + numberToWords(r) : '');
  }
  if (len === 6) return a[Math.floor(num / 100000)] + ' Lakh' + (num % 100000 ? ' ' + numberToWords(num % 100000) : '');
  if (len === 7) {
    const l = Math.floor(num / 100000);
    const r = num % 100000;
    return numberToWords(l) + ' Lakh' + (r ? ' ' + numberToWords(r) : '');
  }
  return String(num);
}

// ---------- Helper: KGID Reference ----------
function generateKgidRef(facultyId, month, year) {
  const random = Math.floor(Math.random() * 9000) + 1000;
  const monthCode = String(new Date(`${month} 1, ${year}`).getMonth() + 1).padStart(2, '0');
  return `KGID/${year}/${monthCode}/${String(facultyId).padStart(4, '0')}/${random}`;
}

// ---------- Helper: Calculate Days ----------
function calculateDays(from, to) {
  return Math.ceil((new Date(to) - new Date(from)) / (1000 * 60 * 60 * 24)) + 1;
}

