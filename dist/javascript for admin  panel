// ---------- Payslip ----------
app.get('/api/payslip', (req, res) => {
  const { facultyId, month, year } = req.query;
  if (!facultyId) return res.status(400).json({ error: 'facultyId is required' });

  const id = parseInt(facultyId);
  const faculty = facultyData.find(f => f.id === id);
  if (!faculty) return res.status(404).json({ error: 'Faculty not found' });

  const currentMonth = month || new Date().toLocaleString('default', { month: 'long' });
  const currentYear = year || new Date().getFullYear();

  // Salary calculation
  const basic = faculty.basicPay || 0;
  const hra = Math.round(basic * 0.24);
  const da = Math.round(basic * 0.17);
  const ta = Math.round(basic * 0.08);
  const special = Math.round(basic * 0.12);
  const medical = 1250;
  const conveyance = 1600;
  const totalEarnings = basic + hra + da + ta + special + medical + conveyance;

  const pf = Math.round(totalEarnings * 0.12);
  const profTax = Math.round(basic * 0.005);
  const esi = Math.round(totalEarnings * 0.0075);
  const it = Math.round((totalEarnings - pf - 50000) * 0.1 > 0 ? (totalEarnings - pf - 50000) * 0.1 : 0);
  const totalDeductions = pf + profTax + esi + it;
  const netPay = totalEarnings - totalDeductions;

  // Leave balance
  const takenLeaves = leaveData
    .filter(l => l.facultyId === faculty.id && l.status === 'approved')
    .reduce((sum, l) => sum + l.days, 0);
  const leaveBalance = 30 - takenLeaves;

  const daysInMonth = new Date(currentYear, new Date(`${currentMonth} 1, ${currentYear}`).getMonth() + 1, 0).getDate();
  const workingDays = daysInMonth - 4; // assuming 4 Sundays
  const presentDays = workingDays - takenLeaves;

  const kgidRef = generateKgidRef(faculty.id, currentMonth, currentYear);
  const payslipNumber = `PS/${currentYear}/${String(faculty.id).padStart(3, '0')}/${String(Math.floor(Math.random() * 9000) + 1000)}`;

  const payslip = {
    payslipNumber,
    kgidRef,
    faculty: {
      id: faculty.id,
      name: faculty.name,
      department: faculty.department,
      designation: faculty.designation,
      joining: faculty.joining,
      bankAccount: faculty.bankAccount || '—',
      ifsc: faculty.ifsc || '—',
      pan: faculty.pan || '—',
      uan: faculty.uan || '—',
      email: faculty.email,
      phone: faculty.phone,
      address: faculty.address,
    },
    month: currentMonth,
    year: currentYear,
    daysInMonth,
    workingDays,
    presentDays,
    leaveBalance,
    salary: {
      basic,
      earnings: { hra, da, ta, special, medical, conveyance, total: totalEarnings },
      deductions: { pf, profTax, esi, it, total: totalDeductions },
      grossPay: totalEarnings,
      totalDeductions,
      netPay,
      netPayWords: numberToWords(Math.round(netPay)) + ' Rupees Only',
    },
    generatedOn: new Date().toISOString(),
    status: 'PAID',
  };

  res.json(payslip);
});

