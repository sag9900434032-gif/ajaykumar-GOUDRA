app.get('/api/stats', (req, res) => {
  const totalAdmissions = admissionData.length;
  const pendingAdmissions = admissionData.filter(a => a.status === 'pending').length;
  const approvedAdmissions = admissionData.filter(a => a.status === 'approved').length;
  const rejectedAdmissions = admissionData.filter(a => a.status === 'rejected').length;
  const totalStudents = studentData.length;
  const totalFaculty = facultyData.length;
  const pendingLeaves = leaveData.filter(l => l.status === 'pending').length;
  const approvedLeaves = leaveData.filter(l => l.status === 'approved').length;

  const deptCount = {};
  facultyData.forEach(f => {
    deptCount[f.department] = (deptCount[f.department] || 0) + 1;
  });

  const totalPayroll = facultyData.reduce((sum, f) => sum + (f.basicPay || 0), 0);
  const avgExp = facultyData.length > 0
    ? (facultyData.reduce((sum, f) => sum + (f.experience || 0), 0) / facultyData.length).toFixed(1)
    : 0;

  res.json({
    admissions: {
      total: totalAdmissions,
      pending: pendingAdmissions,
      approved: approvedAdmissions,
      rejected: rejectedAdmissions,
    },
    students: totalStudents,
    faculty: {
      total: totalFaculty,
      departments: deptCount,
      totalPayroll,
      avgExperience: avgExp,
    },
    leaves: {
      pending: pendingLeaves,
      approved: approvedLeaves,
    },
    todayRegistrations: Math.floor(Math.random() * 5) + 1,
  });
});

