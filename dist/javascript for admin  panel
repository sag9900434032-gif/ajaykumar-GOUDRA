function refreshStudents() {
  studentData = admissionData
    .filter(a => a.status === 'approved')
    .map((a, idx) => ({
      id: idx + 1,
      name: a.name,
      stream: a.stream,
      grade: a.grade,
      email: a.email,
      status: 'active',
      admissionId: a.id
    }));
  nextStudentId = studentData.length + 1;
}

