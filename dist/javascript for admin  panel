// ---------- Health Check ----------
app.get('/api/health', (req, res) => {
  res.json({ status: 'OK', timestamp: new Date().toISOString() });
});

// ---------- Admissions ----------
app.get('/api/admissions', (req, res) => {
  const { status, stream, search } = req.query;
  let result = [...admissionData];
  if (status && status !== 'all') result = result.filter(a => a.status === status);
  if (stream && stream !== 'all') result = result.filter(a => a.stream === stream);
  if (search) {
    const s = search.toLowerCase();
    result = result.filter(a =>
      a.name.toLowerCase().includes(s) ||
      String(a.id).includes(s) ||
      a.email.toLowerCase().includes(s)
    );
  }
  res.json(result);
});

app.get('/api/admissions/:id', (req, res) => {
  const id = parseInt(req.params.id);
  const admission = admissionData.find(a => a.id === id);
  if (!admission) return res.status(404).json({ error: 'Admission not found' });
  res.json(admission);
});

app.post('/api/admissions', (req, res) => {
  const newAdmission = { ...req.body, id: nextAdmissionId++, status: 'pending' };
  const required = ['name', 'dob', 'gender', 'nationality', 'category', 'phone', 'email',
    'address', 'father', 'mother', 'income', 'emergency', 'stream', 'grade', 'school',
    'sslc', 'board', 'passingYear'];
  for (const field of required) {
    if (!newAdmission[field]) {
      return res.status(400).json({ error: `Missing required field: ${field}` });
    }
  }
  admissionData.push(newAdmission);
  res.status(201).json(newAdmission);
});

app.put('/api/admissions/:id', (req, res) => {
  const id = parseInt(req.params.id);
  const index = admissionData.findIndex(a => a.id === id);
  if (index === -1) return res.status(404).json({ error: 'Admission not found' });

  const { status } = req.body;
  if (!status || !['pending', 'approved', 'rejected'].includes(status)) {
    return res.status(400).json({ error: 'Invalid status' });
  }

  admissionData[index].status = status;

  if (status === 'approved') {
    const exists = studentData.some(s => s.admissionId === id);
    if (!exists) {
      const a = admissionData[index];
      studentData.push({
        id: nextStudentId++,
        name: a.name,
        stream: a.stream,
        grade: a.grade,
        email: a.email,
        status: 'active',
        admissionId: a.id
      });
    }
  } else if (status === 'rejected') {
    studentData = studentData.filter(s => s.admissionId !== id);
  }

  res.json(admissionData[index]);
});

app.delete('/api/admissions/:id', (req, res) => {
  const id = parseInt(req.params.id);
  const index = admissionData.findIndex(a => a.id === id);
  if (index === -1) return res.status(404).json({ error: 'Admission not found' });

  studentData = studentData.filter(s => s.admissionId !== id);
  admissionData.splice(index, 1);
  res.status(204).send();
});

