{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "aurora": {
      "root": "aurora",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "aurora",
        "path": "/"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "aurora",
        "path": "/$1"
      }
    },
    {
      "source": "/backend/admin-panel.html",
      "destination": {
        "service": "aurora",
        "path": "/"
      }
    },
    {
      "source": "/admission",
      "destination": {
        "service": "app",
        "path": "/admission-portal.html"
      }
    },
    {
      "source": "/admissions",
      "destination": {
        "service": "app",
        "path": "/admission-portal.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
