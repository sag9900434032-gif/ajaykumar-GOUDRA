app.post('/api/exam-results', authenticate, (req, res) => {
    const { student_id, student_name, exam_name, subject, marks_obtained, total_marks } = req.body;
    if (!student_name || !exam_name || !subject) return res.status(400).json({ error: 'Required fields missing' });
    const pct = total_marks ? (marks_obtained / total_marks) * 100 : 0;
    let grade = 'F';
    if (pct >= 90) grade = 'A+';
    else if (pct >= 80) grade = 'A';
    else if (pct >= 70) grade = 'B';
    else if (pct >= 60) grade = 'C';
    else if (pct >= 50) grade = 'D';
    const result = db.prepare(`INSERT INTO exam_results (student_id, student_name, exam_name, subject, marks_obtained, total_marks, grade) VALUES (?, ?, ?, ?, ?, ?, ?)`)
        .run(student_id || null, student_name, exam_name, subject, marks_obtained, total_marks, grade);
    res.status(201).json({ success: true, id: result.lastInsertRowid, grade });
});

