app.get('/api/reports/:type', authenticate, (req, res) => {
    const type = req.params.type;
    let data = [];
    let title = '';

    switch (type) {
        case 'attendance':
            data = db.prepare(`SELECT id, person_name as name, stream, status, date FROM attendance ORDER BY date DESC`).all();
            title = 'Attendance Report';
            break;
        case 'admission':
            data = db.prepare(`SELECT id, name, stream, grade, sslc_score, email, status FROM admissions ORDER BY id DESC`).all();
            title = 'Admission Report';
            break;
        case 'salary':
            data = db.prepare(`SELECT id, faculty_name as name, stream, basic, da, hra, net_pay as total, status FROM salary ORDER BY id DESC`).all();
            title = 'Salary Report';
            break;
        case 'financial': {
            const collected = db.prepare('SELECT COALESCE(SUM(paid_amount), 0) as c FROM fees WHERE status = "paid"').get().c;
            const pending = db.prepare('SELECT COALESCE(SUM(amount), 0) as c FROM fees WHERE status = "pending"').get().c;
            const payroll = db.prepare('SELECT COALESCE(SUM(net_pay), 0) as c FROM salary').get().c;
            data = [
                { category: 'Total Fees Collected', amount: collected },
                { category: 'Fees Pending', amount: pending },
                { category: 'Total Payroll', amount: payroll },
                { category: 'Net Balance', amount: collected - payroll }
            ];
            title = 'Financial Report';
            break;
        }
        case 'student':
            data = db.prepare(`SELECT id, name, stream, grade, email, status FROM students ORDER BY id DESC`).all();
            title = 'Student Report';
            break;
        case 'faculty':
            data = db.prepare(`SELECT id, name, stream, subject, qualification, experience, status FROM faculty ORDER BY id DESC`).all();
            title = 'Faculty Report';
            break;
        case 'fee':
            data = db.prepare(`SELECT id, student_name as student, stream, amount, due_date, status FROM fees ORDER BY id DESC`).all();
            title = 'Fee Collection Report';
            break;
        case 'exam':
            data = db.prepare(`SELECT id, exam_name as exam, class_name as class, exam_date as date, status FROM exams ORDER BY exam_date DESC`).all();
            title = 'Examination Report';
            break;
        default:
            return res.status(400).json({ error: 'Invalid report type' });
    }

    res.json({ success: true, title, data, generated_at: new Date().toISOString() });
});

