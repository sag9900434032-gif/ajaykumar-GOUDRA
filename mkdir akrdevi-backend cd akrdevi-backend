app.get('/api/faculty', authenticate, (req, res) => {
    const { stream, status, search } = req.query;
    let sql = 'SELECT * FROM faculty WHERE 1=1';
    const params = [];
    if (stream && stream !== 'all') { sql += ' AND stream = ?'; params.push(stream); }
    if (status && status !== 'all') { sql += ' AND status = ?'; params.push(status); }
    if (search) { sql += ' AND (name LIKE ? OR subject LIKE ?)'; params.push(`%${search}%`, `%${search}%`); }
    sql += ' ORDER BY id DESC';
    res.json({ success: true, data: db.prepare(sql).all(...params) });
});

app.get('/api/faculty/:id', authenticate, (req, res) => {
    const f = db.prepare('SELECT * FROM faculty WHERE id = ?').get(req.params.id);
    if (!f) return res.status(404).json({ error: 'Faculty not found' });
    res.json({ success: true, data: f });
});

app.post('/api/faculty', authenticate, authorize('SUPER_ADMIN', 'PRINCIPAL', 'ADMIN'), (req, res) => {
    const { name, stream, subject, qualification, experience, status, email, phone, salary } = req.body;
    if (!name || !stream || !subject || !qualification) {
        return res.status(400).json({ error: 'Required fields missing' });
    }
    const result = db.prepare(`INSERT INTO faculty (name, stream, subject, qualification, experience, status, email, phone, salary) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`)
        .run(name, stream, subject, qualification, experience || 0, status || 'active', email || null, phone || null, salary || 0);
    audit(req.user.id, 'CREATE', 'faculty', result.lastInsertRowid, { name }, req.ip);
    res.status(201).json({ success: true, id: result.lastInsertRowid });
});

app.put('/api/faculty/:id', authenticate, authorize('SUPER_ADMIN', 'PRINCIPAL', 'ADMIN'), (req, res) => {
    const { name, stream, subject, qualification, experience, status, email, phone, salary } = req.body;
    const existing = db.prepare('SELECT * FROM faculty WHERE id = ?').get(req.params.id);
    if (!existing) return res.status(404).json({ error: 'Faculty not found' });

    db.prepare(`UPDATE faculty SET name=?, stream=?, subject=?, qualification=?, experience=?, status=?, email=?, phone=?, salary=? WHERE id=?`)
        .run(
            name || existing.name, stream || existing.stream, subject || existing.subject,
            qualification || existing.qualification, experience ?? existing.experience,
            status || existing.status, email ?? existing.email, phone ?? existing.phone,
            salary ?? existing.salary, req.params.id
        );
    audit(req.user.id, 'UPDATE', 'faculty', req.params.id, { name }, req.ip);
    res.json({ success: true });
});

app.delete('/api/faculty/:id', authenticate, authorize('SUPER_ADMIN', 'PRINCIPAL'), (req, res) => {
    const result = db.prepare('DELETE FROM faculty WHERE id = ?').run(req.params.id);
    if (result.changes === 0) return res.status(404).json({ error: 'Faculty not found' });
    audit(req.user.id, 'DELETE', 'faculty', req.params.id, {}, req.ip);
    res.json({ success: true });
});

