app.patch('/api/admissions/:id/status', authenticate, (req, res) => {
    const { status, remarks } = req.body;
    if (!['pending', 'approved', 'rejected', 'hold'].includes(status)) {
        return res.status(400).json({ error: 'Invalid status' });
    }
    const admission = db.prepare('SELECT * FROM admissions WHERE id = ?').get(req.params.id);
    if (!admission) return res.status(404).json({ error: 'Admission not found' });

    db.prepare('UPDATE admissions SET status = ?, remarks = ? WHERE id = ?').run(status, remarks || null, req.params.id);

    // Auto-create student if approved
    if (status === 'approved') {
        const exists = db.prepare('SELECT id FROM students WHERE email = ?').get(admission.email);
        if (!exists && admission.email) {
            db.prepare(`INSERT INTO students (name, stream, grade, email, phone, address, sslc_score, status) VALUES (?, ?, ?, ?, ?, ?, ?, 'active')`)
                .run(admission.name, admission.stream, admission.grade, admission.email, admission.phone, admission.address, admission.sslc_score);
        }
    }
    audit(req.user.id, `ADMISSION_${status.toUpperCase()}`, 'admission', req.params.id, { status }, req.ip);
    res.json({ success: true });
});

