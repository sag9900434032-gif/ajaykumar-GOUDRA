    if (!existing) return res.status(404).json({ error: 'Student not found' });
    const b = req.body;
    db.prepare(`UPDATE students SET name=?, stream=?, grade=?, email=?, phone=?, address=?, father_name=?, mother_name=?, sslc_score=?, status=? WHERE id=?`)
        .run(
            b.name || existing.name, b.stream || existing.stream, b.grade || existing.grade,
            b.email ?? existing.email, b.phone ?? existing.phone, b.address ?? existing.address,
            b.father_name ?? existing.father_name, b.mother_name ?? existing.mother_name,
            b.sslc_score ?? existing.sslc_score, b.status || existing.status, req.params.id
        );
    audit(req.user.id, 'UPDATE', 'student', req.params.id, { name: b.name }, req.ip);
    res.json({ success: true });
});

